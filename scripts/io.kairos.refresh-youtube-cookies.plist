<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.kairos.refresh-youtube-cookies</string>

  <!-- aponta pra cópia em ~/Library/Application Support, não pro repo no SSD
       externo: o macOS (TCC) bloqueia LaunchAgents rodando scripts direto de
       volumes externos ("Operation not permitted"), mesmo com o Terminal
       tendo acesso. Se editar o script, sincronize as duas cópias. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>"$HOME/Library/Application Support/kairos/refresh-youtube-cookies.sh"</string>
  </array>

  <!-- roda a cada 12h enquanto o Mac estiver ligado/acordado; se estiver
       dormindo na hora, o launchd dispara assim que acordar -->
  <key>StartInterval</key>
  <integer>43200</integer>

  <!-- roda uma vez já ao carregar o job (não espera as 12h iniciais) -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/kairos-cookie-refresh.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/kairos-cookie-refresh.stderr.log</string>
</dict>
</plist>
