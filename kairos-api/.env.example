DATABASE_URL=postgres://kairos:kairos@localhost:5432/kairosio
JWT_SECRET=kairos-secret-change-in-prod
PORT=3000

# Jukebox — requer rclone configurado (remote "gdrive") e yt-dlp/ffmpeg no PATH
RCLONE_CONFIG_PATH=/root/.config/rclone/rclone.conf
DRIVE_REMOTE=gdrive:kairos-music
MUSIC_CACHE_DIR=./music-cache
MUSIC_CACHE_MAX_BYTES=10737418240
# IPs de datacenter levam bloqueio anti-bot do YouTube — exporte um cookies.txt de
# uma sessão logada (extensão "Get cookies.txt") e aponte aqui. Sem isso, downloads falham.
COOKIES_FILE=/app/cookies/youtube.txt
