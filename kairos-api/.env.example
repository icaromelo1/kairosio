DATABASE_URL=postgres://kairos:kairos@localhost:5432/kairosio
JWT_SECRET=kairos-secret-change-in-prod
PORT=3000

# Jukebox — requer rclone configurado (remote "gdrive") e yt-dlp/ffmpeg no PATH
RCLONE_CONFIG_PATH=/root/.config/rclone/rclone.conf
DRIVE_REMOTE=gdrive:kairos-music
MUSIC_CACHE_DIR=./music-cache
# expiração é por tempo (7 dias sem tocar), não por espaço — ver JukeboxService.pruneStaleTracks
# IPs de datacenter levam bloqueio anti-bot do YouTube — exporte um cookies.txt de
# uma sessão logada (extensão "Get cookies.txt") e aponte aqui. Sem isso, downloads falham.
COOKIES_FILE=/app/cookies/youtube.txt
# PO Token provider (sidecar bgutil-ytdlp-pot-provider) — YouTube passou a exigir esse
# token junto com cookies pro gate anti-bot. Serviço "bgutil-provider" no docker-compose.
POT_PROVIDER_URL=http://bgutil-provider:4416
# limite de duração pra aceitar um link no jukebox (segundos) — rejeita lives em
# andamento e vídeos longos demais (podcasts, streams gravadas, etc.)
JUKEBOX_MAX_DURATION_SEC=1200

# Foto de perfil — mesmo rclone acima, remote/cache separados do jukebox
AVATAR_DRIVE_REMOTE=gdrive:kairos-avatars
AVATAR_CACHE_DIR=./avatar-cache
